apiVersion: v1
kind: Secret
metadata:
  name: borzoi-secrets
type: Opaque
stringData:
  # PostgreSQL connection string
  database-url: "postgresql://USER:PASSWORD@HOST:PORT/DB_NAME"

  # Random 32-byte hex key for encrypting ClickHouse credentials stored in DB
  # Generate: openssl rand -hex 32
  encryption-key: ""

  # OIDC client_secret (only needed when AUTH_OIDC_ENABLED=true in configmap.yaml)
  # client_id is not a secret — keep it in configmap.yaml as AUTH_OIDC_CLIENT_ID instead
  oidc-client-secret: ""
