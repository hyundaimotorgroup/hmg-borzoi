#!/bin/bash

# Kubernetes deployment script

set -e

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Environment settings
ENVIRONMENT="${ENVIRONMENT:-dev}"
K8S_NAMESPACE="${K8S_NAMESPACE:-borzoi}"
REGISTRY_URL="${REGISTRY_URL:-your-registry.example.com}"
REGISTRY_USERNAME="${REGISTRY_USERNAME:-your-username}"
APP_DEPLOYMENT_NAME="${APP_DEPLOYMENT_NAME:-borzoi}"
DEPLOYMENT_FILE="${DEPLOYMENT_FILE:-deploy/k8s/deployment.yaml}"
REGISTRY_SECRET_NAME="${REGISTRY_SECRET_NAME:-registry-secret}"

uses_mutable_image_tag() {
  [ -f "${DEPLOYMENT_FILE}" ] || return 1
  grep -Eq 'image:[[:space:]]+.*:latest([[:space:]]|$)' "${DEPLOYMENT_FILE}"
}

# Print usage information.
if [ "$1" == "-h" ] || [ "$1" == "--help" ]; then
  echo "Usage: $0"
  echo ""
  echo "  -h, --help              Show help"
  echo ""
  echo "Environment variables:"
  echo "  ENVIRONMENT             Deployment environment (dev, prod, etc.; default: dev)"
  echo "  K8S_NAMESPACE           Kubernetes namespace (default: borzoi)"
  echo "  REGISTRY_PASSWORD       Container registry password (required)"
  echo ""
  echo "Example:"
  echo "  ENVIRONMENT=prod K8S_NAMESPACE=borzoi-prod ./deploy.sh"
  exit 0
fi

printf "${BLUE}========================================${NC}"
printf "${BLUE}  Kubernetes deployment${NC}"
printf "${BLUE}========================================${NC}"
echo ""
printf "Environment: ${GREEN}${ENVIRONMENT}${NC}"
printf "Namespace: ${GREEN}${K8S_NAMESPACE}${NC}"
echo ""

# 1. Create the namespace if it does not already exist.
printf "${YELLOW}[1/3] Creating namespace...${NC}"
kubectl create namespace ${K8S_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
printf "${GREEN}✓ Namespace ready${NC}"
echo ""

# 2. Create the registry Secret if it does not already exist.
printf "${YELLOW}[2/3] Checking registry Secret...${NC}"
if kubectl get secret ${REGISTRY_SECRET_NAME} -n ${K8S_NAMESPACE} &>/dev/null; then
  printf "${GREEN}✓ Secret ${REGISTRY_SECRET_NAME} already exists. Skipping.${NC}"
else
  if [ -z "${REGISTRY_PASSWORD}" ]; then
    printf "${RED}✗ REGISTRY_PASSWORD environment variable is not set.${NC}"
    exit 1
  fi
  kubectl create secret docker-registry ${REGISTRY_SECRET_NAME} \
    --docker-server=${REGISTRY_URL} \
    --docker-username=${REGISTRY_USERNAME} \
    --docker-password=${REGISTRY_PASSWORD} \
    -n ${K8S_NAMESPACE}
  printf "${GREEN}✓ Secret ${REGISTRY_SECRET_NAME} created${NC}"
fi
echo ""

# 3. Deploy Kubernetes resources.
printf "${YELLOW}[3/3] Deploying Kubernetes resources...${NC}"

kubectl apply -f deploy/k8s/configmap.yaml -n ${K8S_NAMESPACE}

if [ -f "deploy/k8s/ingress.yaml" ]; then
  kubectl apply -f deploy/k8s/ingress.yaml -n ${K8S_NAMESPACE}
fi

kubectl apply -f deploy/k8s/service.yaml -n ${K8S_NAMESPACE}
kubectl apply -f ${DEPLOYMENT_FILE} -n ${K8S_NAMESPACE}

if uses_mutable_image_tag; then
  printf "${YELLOW}Restarting rollout because the image uses a mutable tag (:latest)...${NC}"
  kubectl rollout restart deployment/${APP_DEPLOYMENT_NAME} -n ${K8S_NAMESPACE}
fi

kubectl rollout status deployment/${APP_DEPLOYMENT_NAME} -n ${K8S_NAMESPACE}
printf "${GREEN}✓ Deployment complete${NC}"
echo ""

# Check deployment status.
printf "${BLUE}========================================${NC}"
printf "${GREEN}✓ Deployment successful!${NC}"
printf "${BLUE}========================================${NC}"
echo ""
echo "Check deployment status:"
echo "  ${YELLOW}kubectl get all -n ${K8S_NAMESPACE}${NC}"
echo ""
echo "Access the service:"
echo "  ${YELLOW}kubectl port-forward svc/${APP_DEPLOYMENT_NAME} 3000:80 -n ${K8S_NAMESPACE}${NC}"
echo "  Or check the Ingress host: kubectl get ingress -n ${K8S_NAMESPACE}"
echo ""
echo "View logs:"
echo "  ${YELLOW}kubectl logs -f deployment/${APP_DEPLOYMENT_NAME} -n ${K8S_NAMESPACE}${NC}"
echo ""
