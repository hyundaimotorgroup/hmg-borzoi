# 국문 예시: .env.local로 복사한 후 값을 설정하세요.

# PostgreSQL 연결; deploy/docker/docker-compose.yml의 비밀번호를 사용합니다.
DATABASE_URL="postgresql://borzoi_user:password@localhost:5433/borzoi"

# 개발용 목업 데이터 사용 여부.
NEXT_PUBLIC_USE_MOCK=false

# API 주소.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ClickHouse 자격증명 암호화 키 (32자 이상의 무작위 문자열).
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-secret-encryption-key-minimum-32-characters

# 유휴 상태 자동 로그아웃 시간(분); 빈 값 또는 0이면 비활성화됩니다.
SESSION_IDLE_TIMEOUT_MINUTES=30

# 활동 여부와 관계없는 최대 세션 유지 시간(분, 기본값: 1440).
SESSION_MAX_LIFETIME_MINUTES=1440

# 비밀번호 로그인을 사용할 때 공개 회원가입 허용 여부.
ALLOW_PUBLIC_REGISTRATION=false

# Query Editor 페이지와 관련 API 활성화 여부.
ENABLE_QUERY_EDITOR=true

# HTTP 인증 쿠키 허용 여부; 로컬 HTTP 개발 환경에서만 true를 사용합니다.
AUTH_COOKIE_ALLOW_INSECURE=false

# 운영 외 환경의 HTTP 알림 웹훅 허용 여부; 운영에서는 항상 HTTPS를 사용합니다.
ALERT_ALLOW_INSECURE_WEBHOOKS=false

# OIDC (선택 사항)
# SSO 활성화 시 비밀번호 로그인과 공개 회원가입이 비활성화됩니다.
AUTH_OIDC_ENABLED=false

# OIDC 자동 검색을 지원하는 인증 제공자의 issuer URL.
AUTH_OIDC_ISSUER=https://idp.example.com

# 인증 제공자에서 발급받은 클라이언트 정보.
AUTH_OIDC_CLIENT_ID=your-client-id
AUTH_OIDC_CLIENT_SECRET=your-client-secret

# 로그인 콜백과 리다이렉트에 사용할 앱의 공개 URL.
AUTH_OIDC_BASE_URL=http://localhost:3000

# 요청할 OIDC 스코프.
AUTH_OIDC_SCOPE="openid profile email"

# 앱 사용자 식별에 사용할 ID 토큰 클레임.
AUTH_OIDC_USER_NAME_CLAIM=email

# 식별자 추출 정규식; 첫 번째 캡처 그룹이 있으면 해당 값을 사용합니다.
AUTH_OIDC_USER_NAME_CLAIM_REGEX="(.*)"

# 클라이언트 인증 방식: client_secret_basic 또는 client_secret_post.
AUTH_OIDC_CLIENT_AUTHENTICATION_METHOD=client_secret_basic

# 사용자 클레임이 email일 때의 email_verified 검증 정책:
# trust: false만 거부; require: true만 허용; ignore: 검증 생략.
AUTH_OIDC_EMAIL_VERIFIED_POLICY=trust

# 첫 SSO 로그인 시 한 번만 관리자 및 기존 클러스터 접근 권한을 부여할 이메일(쉼표 구분).
AUTH_OIDC_ADMIN_EMAILS=admin1@example.com,admin2@example.com
