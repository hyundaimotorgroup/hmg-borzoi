# English example: copy to .env.local and update values.

# PostgreSQL connection; use the password from deploy/docker/docker-compose.yml.
DATABASE_URL="postgresql://borzoi_user:password@localhost:5433/borzoi"

# Use mock data for development.
NEXT_PUBLIC_USE_MOCK=false

# API endpoint.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ClickHouse credential encryption key (at least 32 random characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-secret-encryption-key-minimum-32-characters

# Log out after this many idle minutes; empty or 0 disables the timeout.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Maximum session lifetime in minutes, regardless of activity (default: 1440).
SESSION_MAX_LIFETIME_MINUTES=1440

# Allow public registration when password login is enabled.
ALLOW_PUBLIC_REGISTRATION=false

# Enable the Query Editor page and related APIs.
ENABLE_QUERY_EDITOR=true

# Allow auth cookies over HTTP; use true only for local HTTP development.
AUTH_COOKIE_ALLOW_INSECURE=false

# Allow HTTP alert webhooks outside production; production always requires HTTPS.
ALERT_ALLOW_INSECURE_WEBHOOKS=false

# OIDC (optional)
# Enable SSO; disables password login and public registration.
AUTH_OIDC_ENABLED=false

# Identity provider issuer URL with OIDC discovery support.
AUTH_OIDC_ISSUER=https://idp.example.com

# Credentials issued by the identity provider.
AUTH_OIDC_CLIENT_ID=your-client-id
AUTH_OIDC_CLIENT_SECRET=your-client-secret

# Public application URL used for login callbacks and redirects.
AUTH_OIDC_BASE_URL=http://localhost:3000

# Requested OIDC scopes.
AUTH_OIDC_SCOPE="openid profile email"

# ID token claim used to identify application users.
AUTH_OIDC_USER_NAME_CLAIM=email

# Identifier extraction regex; uses the first capture group if present.
AUTH_OIDC_USER_NAME_CLAIM_REGEX="(.*)"

# Client authentication: client_secret_basic or client_secret_post.
AUTH_OIDC_CLIENT_AUTHENTICATION_METHOD=client_secret_basic

# email_verified policy when the user claim is email:
# trust: reject false; require: accept only true; ignore: skip verification.
AUTH_OIDC_EMAIL_VERIFIED_POLICY=trust

# Comma-separated emails granted admin and existing cluster access once on first SSO login.
AUTH_OIDC_ADMIN_EMAILS=admin1@example.com,admin2@example.com
